{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "esnext.decorators"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "outDir": ".temp/compiled",
    "rootDir": ".",
    "strict": true,
    "skipLibCheck": true,
    "useDefineForClassFields": true
  },
  "include": ["**/*"],
  "exclude": [".temp/**/*", "functions/**/*"]
}
